{
  "name": "mimic-polimi",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:polimi": "env BASE_PATH= next build",
    "start": "next start",
    "lint": "next lint",
    "deploy": "gh-pages -d out --dotfiles",
    "publish:github": "npm run build && npm run deploy",
    "deploy:polimi": "bash scripts/deploy-polimi-ftp.sh",
    "sync:polimi": "SKIP_BUILD=1 bash scripts/deploy-polimi-ftp.sh",
    "sync:gitlab": "bash scripts/sync-gitlab.sh",
    "publish:all": "npm run publish:github && npm run deploy:polimi && npm run sync:gitlab"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.97.0",
    "@types/leaflet": "^1.9.21",
    "framer-motion": "^11.0.3",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.323.0",
    "next": "14.2.35",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.56.0",
    "eslint-config-next": "14.2.35",
    "gh-pages": "^6.3.0",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3"
  }
}
