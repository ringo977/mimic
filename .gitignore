# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# Polimi FTP deploy credentials (never commit)
deploy.polimi.env

# GitLab deploy credentials and cached clone (never commit)
deploy.gitlab.env
.gitlab-clone/

# Credentials file
mimic passwd.txt

# Secret notes (Supabase keys, GitLab PAT, Resend API key, etc.) — never commit
Supabase.rtf
Token MiMic Push.rtf
*.rtf

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.claude/

# Original uncompressed photos + internal documents, kept locally only.
# Outside public/ so they never end up in the build or on the server.
/assets-originals/

# Reference-only material (conference programmes etc., kept locally, never published)
/reference/
